# Gemini API Key (for contract analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI - Document Expert
VITE_OPENAI_API_KEY=sk-proj-xxx

# Neo4j Aura Configuration
VITE_NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
VITE_NEO4J_USERNAME=neo4j
VITE_NEO4J_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
